<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Docker.Manager.UnitTests
===============================================================================
    单元测试项目。xUnit + FluentAssertions + coverlet。

    当前 0.0.1 仅含占位用例（验证测试链路通畅 + 依赖方向正确）。
    0.0.3 起覆盖密码哈希；0.0.4 起覆盖登录；0.0.8 起引入 IntegrationTests 项目。
  -->

  <PropertyGroup>
    <RootNamespace>Docker.Manager.UnitTests</RootNamespace>
    <AssemblyName>Docker.Manager.UnitTests</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- 仅 AssemblyName 与 Api 项目对齐的 InternalsVisibleTo 一致 -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Docker.Manager.Domain\Docker.Manager.Domain.csproj" />
    <ProjectReference Include="..\..\src\Docker.Manager.Application\Docker.Manager.Application.csproj" />
  </ItemGroup>

</Project>