<Project>
  <!--
    Directory.Packages.props
    ===========================================================================
    Central Package Management (CPM) 集中版本表。
    所有 NuGet 包版本号集中此文件管理；csproj 中只引用包名，不再写版本号。
    启用位置：本文件 <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  -->

  <PropertyGroup>
    <!-- CPM 启用（实际开关在 Directory.Build.props；此处冗余写一次以提升可见性） -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- ============ ASP.NET Core / Web ============ -->
    <!-- .NET 10 内置，无需单独版本号；保留占位供后续追加 Microsoft.AspNetCore.* 包 -->
    <!-- 集成测试宿主（WebApplicationFactory / TestServer），版本须与本机 ASP.NET Core 运行时一致 -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- JWT 鉴权中间件（AddAuthentication().AddJwtBearer()）；也传递引入 Microsoft.IdentityModel.* -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <!-- JWT 签发（Infrastructure/Security/JwtTokenService）：只造令牌，不含鉴权中间件。
         版本对齐 Microsoft.AspNetCore.Authentication.JwtBearer 传递引入的 Microsoft.IdentityModel.*。 -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.15.0" />

    <!-- ============ Microsoft.Extensions（DI / Logging / Options / Configuration） ============ -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />

    <!-- ============ Serilog（日志） ============ -->
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />

    <!-- ============ Docker SDK ============ -->
    <PackageVersion Include="Docker.DotNet.Enhanced" Version="4.3.3" />
    <!-- 认证处理器：与主包同版本。X509 = 客户端证书（TLS 双向认证）；BasicAuth = 用户名/密码。 -->
    <PackageVersion Include="Docker.DotNet.Enhanced.BasicAuth" Version="4.3.3" />
    <PackageVersion Include="Docker.DotNet.Enhanced.X509" Version="4.3.3" />

    <!-- ============ 安全（密码哈希） ============ -->
    <!-- MIT 许可（本项目亦为 MIT）。它只输出原始字节，PHC 编码串由 Core/Auth/PasswordHash 值对象负责。
         未选 Isopoh.Cryptography.Argon2：其为 CC-BY-4.0（Creative Commons 内容许可，官方不建议用于软件）。 -->
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />

    <!-- ============ 持久化（Dapper + SQLite） ============ -->
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />

    <!-- ============ 测试（xUnit + FluentAssertions + coverlet） ============ -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!-- FluentAssertions 停留在 7.x：8.x 起改为 Xceed 商业授权，7.x 是最后的 Apache-2.0 版本 -->
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>
</Project>