# ============================================================================
# Whalefleet 部署所需的密钥
# ============================================================================
# 复制为 .env 后填入真实值：cp .env.example .env
# ⚠️ .env 已被 .dockerignore 排除，不会进镜像；但请勿提交到版本库。

# ---------- 必填 ----------
# JWT 签名密钥。缺失或过短会导致启动失败。
# 生成：openssl rand -base64 48
JWT__SECRET=

# 初始管理员密码。密码强度不达标会导致启动失败（这是有意的）。
# 强度要求：大写 + 小写 + 数字 + 符号，长度 ≥ 12。
# ⚠️ 仅在 users 表为空时生效。首次登录后请在界面改密，
#    并从 docker-compose.yml 中移除 ADMIN__USER / ADMIN__PASSWORD。
ADMIN__PASSWORD=

# ---------- 可选 ----------
# 初始管理员用户名，默认 admin
ADMIN__USER=admin

# 容器时区，默认 UTC
TZ=UTC

# 镜像地址。默认用本地构建的镜像（docker build -t whalefleet:local .）。
# 0.0.x 不推送 GHCR，因此本地 tag 是当前唯一可用的来源；
# 首个对外镜像将随 v0.1.0 发布。
WHALEFLEET_IMAGE=whalefleet:local
