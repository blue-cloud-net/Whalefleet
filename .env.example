# ============================================================================
# Whalefleet 部署配置（**全部可选**）
# ============================================================================
# 本文件用于覆盖默认值。**不复制这个文件也能直接启动**：
#
#     docker compose up -d
#     docker compose exec whalefleet cat /app/data/initial-admin.txt   # 取初始密码
#
# 未显式设置的密钥会在首次启动时自动生成并持久化到数据卷。
# ⚠️ .env 已被 .gitignore 与 .dockerignore 双重排除，不会进镜像、也不会进版本库。

# ---------- 初始管理员 ----------
# 仅在 users 表为空（全新部署）时生效；之后改这里无效，请到管理界面改密码。
# ⚠️ 不设置时自动生成随机密码并写入 /app/data/initial-admin.txt（权限 0600）。
#    密码**不写日志**——只会在首次启动时落盘一次，请及时取回并删除该文件。
ADMIN__USER=admin
ADMIN__PASSWORD=

# ---------- JWT 签名密钥 ----------
# ⚠️ 不设置时首次启动自动生成到 /app/data/jwt.key（权限 0600），此后每次启动复用。
#
#    **务必随数据卷一起备份**：密钥变了，此前所有已签发的登录令牌立即失效，
#    所有在线用户会被迫重新登录。scripts/backup.sh 已包含该文件。
#
#    需要显式设置的场景：多实例共用同一密钥、密钥轮换、或由外部密钥管理系统注入。
#    生成：openssl rand -base64 48
JWT__SECRET=

# ---------- Docker socket 权限 ----------
# 容器内 app 用户（UID 10001）通常不在宿主机 docker 组，直挂 socket 会报 1301
# 「无法连接 Docker 守护进程」。取值：stat -c '%g' /var/run/docker.sock
DOCKER_GID=983

# ---------- 反向代理（置于 nginx / Traefik 之后时必填） ----------
#
# 镜像内**只监听明文 HTTP**，生产部署必须前置 HTTPS 反代（示例见 examples/reverse-proxy/）。
#
# ⚠️ 这一段不是可选的安全加固，而是**启用反代后的必填项**：
#   不设 → 应用不采信 X-Forwarded-For（该头可伪造，采信等于让攻击者自己选限流键）；
#   配了第 1 行不配下面两行 → **所有用户共用一个登录限流桶**，
#   5 次失败后全体用户在 1 分钟内都登不进去，而日志里看不出任何异常。
#
# 反代侧必须传：X-Forwarded-Proto、X-Forwarded-For、Host（示例配置里都已包含）。
#
# 取值方式：
#   * 反代与应用在同一 docker 网络 → 用网段（地址会变，逐个列举 IP 要频繁改）
#     先查网段：docker network inspect <网络名> | grep Subnet
#   * 反代是独立进程或独立机器 → 用精确地址（docker network inspect bridge -f '{{.IPAddress}}'）
#
# ⚠️ 不要填 0.0.0.0/0 或 ::/0：那等于采信任何人的伪造头。
# ⚠️ 地址写错会在**启动时**失败（不静默忽略）——因为静默忽略的症状与「完全没配」
#    完全同形，几乎无从排查。
REVERSEPROXY__ENABLED=false
REVERSEPROXY__KNOWNPROXIES=
REVERSEPROXY__KNOWNNETWORKS=

# ---------- 其他 ----------
# 容器时区，默认 UTC
TZ=UTC

# 镜像地址。默认用本地构建的镜像（docker build -t whalefleet:local .）。
# 0.x 不对外发布镜像，因此本地 tag 是当前唯一可用的来源；
# 首个对外镜像将随 v1.0.0-rc.1 发布，届时可改为 ghcr.io/blue-cloud-net/whalefleet:1.0.0
WHALEFLEET_IMAGE=whalefleet:local
