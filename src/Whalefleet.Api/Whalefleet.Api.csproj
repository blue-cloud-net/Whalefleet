<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Whalefleet.Api
===============================================================================
    接口层。ASP.NET Core 10 宿主进程，托管 Controllers / SignalR Hubs / 静态前端。

    依赖：Application + Infrastructure（不直接依赖 Core）。

    监听：开发环境 :8080；生产环境通过 Kestrel 配置或容器编排覆盖。
  -->

  <ItemGroup>
    <InternalsVisibleTo Include="Whalefleet.UnitTests" />
    <!-- 0.0.15：ReverseProxy 配置解析是 internal，但它的失败模式（「静默忽略写错的代理」）
         必须能被钉住；集成测试是唯一可测 Api 内部的测试项目（单测项目禁止引用 Api）。 -->
    <InternalsVisibleTo Include="Whalefleet.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Whalefleet.Application\Whalefleet.Application.csproj" />
    <ProjectReference Include="..\Whalefleet.Infrastructure\Whalefleet.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <!-- 滚动文件 sink：显式引用而非依赖 Serilog.AspNetCore 的传递依赖 -->
    <PackageReference Include="Serilog.Sinks.File" />
    <!-- JWT 鉴权中间件（0.0.4） -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

</Project>