{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Docker.DotNet": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "/app/data/logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": false,
          "rollOnFileSizeLimit": false,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext}: {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "Urls": "http://+:8080",
  "Cors": {
    "AllowedOrigins": []
  },
  "Persistence": {
    "DatabasePath": "/app/data/whalefleet.db",
    "CommandTimeoutSeconds": 30
  },
  "ReverseProxy": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Spa": {
    "Enabled": true,
    "RootPath": "wwwroot",
    "IndexFile": "index.html"
  },
  "Docker": {
    "Pool": {
      "IdleTimeout": "00:30:00",
      "ReapInterval": "00:05:00"
    }
  },
  "Files": {
    "AllowWrite": true,
    "MaxUploadBytes": 21474836480,
    "TempDirectory": "/app/data/exports",
    "TicketTtl": "00:10:00",
    "ExportTtl": "01:00:00",
    "MaxConcurrentExports": 2,
    "HelperImage": "whalefleet/volfs-helper:0.14.0",
    "SweepInterval": "00:01:00",
    "MaxListEntries": 5000
  },
  "Terminal": {
    "DefaultShell": "/bin/sh",
    "AllowedShells": [ "/bin/sh", "/bin/bash", "/bin/ash", "/bin/zsh" ],
    "AllowCustomCommand": true,
    "TokenLifetime": "00:05:00",
    "MaxSessionsPerUser": 5,
    "KeepAliveSeconds": 30
  },
  "Alerts": {
    "EvaluationIntervalSeconds": 30,
    "ContainerResyncSeconds": 60,
    "MaxMonitoredContainersPerHost": 100,
    "RetentionDays": 90
  },
  "ImageUpdates": {
    "Enabled": true,
    "ScanIntervalSeconds": 3600,
    "ScanJitterSeconds": 90,
    "MaxPoliciesPerScan": 50,
    "RegistryMirrors": []
  },
  "Notifications": {
    "WebhookTimeoutSeconds": 10,
    "SmtpHost": "",
    "SmtpPort": 587,
    "UseStartTls": true,
    "SmtpUsername": "",
    "SmtpPassword": "",
    "FromAddress": "",
    "FromDisplayName": "Whalefleet"
  }
}