{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Docker.DotNet": "Information"
      }
    },
    // 开发环境把日志写到运行目录下的 logs/：非容器环境不存在 /app/data，
    // 直接使用 appsettings.json 中的绝对路径会导致 File sink 打开文件失败。
    // 键路径 Serilog:WriteTo:1:Args:path 对应 appsettings.json 里 WriteTo 数组的第二个元素（File sink）。
    "WriteTo:1:Args:path": "logs/app-.log"
  },
  // 开发环境把数据库放到运行目录下的 data/，与日志同样的理由：
  // 非容器环境不存在 /app/data，用绝对路径会直接打开失败。
  "Persistence": {
    "DatabasePath": "data/whalefleet.db"
  },
  // 开发环境**不**托管前端产物：页面由 Vite 在 5173 提供（它还会代理 /api）。
  // 若这里保持生产值（true），API 会去找 wwwroot——本地没有该目录便直接启动失败；
  // 而即便补一个空目录，Vite 的页面也会被顶掉，表现为「改了前端却没生效」。
  "Spa": {
    "Enabled": false
  },
  // 仅开发环境的 JWT 签名密钥。
  // 生产环境必须用环境变量 JWT__SECRET 覆盖（缺失或过短会导致启动失败）。
  // 这里的值刻意写得像占位符：它公开在仓库里，任何人都不应拿它当生产密钥。
  "Jwt": {
    "Secret": "dev-only-placeholder-secret-not-for-production-use-0123456789"
  }
}