{
  "name": "@docker-manager/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Docker.Manager 前端 — 0.0.5 最小骨架",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,vue,json,css,md}\"",
    "dev:mock": "VITE_ENABLE_MOCK=true vite",
    "dev:real": "vite"
  },
  "dependencies": {
    "@microsoft/signalr": "^9.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "axios": "^1.7.9",
    "element-plus": "^2.14.0",
    "fuse.js": "^7.5.0",
    "pinia": "^4.0.0",
    "pinia-plugin-persistedstate": "^4.1.3",
    "vue": "^3.5.13",
    "vue-i18n": "^11.0.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@iconify-json/carbon": "^1.2.4",
    "@types/node": "^22.10.0",
    "@unocss/preset-icons": "^66.0.0",
    "@unocss/preset-typography": "^66.0.0",
    "@unocss/preset-uno": "^66.0.0",
    "@unocss/reset": "^66.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.0",
    "eslint": "^9.16.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^25.0.1",
    "msw": "^3.0.3",
    "prettier": "^3.4.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.18.0",
    "unocss": "^66.0.0",
    "vite": "^7.0.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.1.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
