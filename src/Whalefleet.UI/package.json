{
  "name": "@whalefleet/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Whalefleet 前端 — 0.0.5 最小骨架",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,vue,json,css,md}\"",
    "dev:mock": "VITE_ENABLE_MOCK=true vite",
    "dev:real": "vite"
  },
  "dependencies": {
    "@microsoft/signalr": "^9.0.19",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "axios": "^1.20.0",
    "element-plus": "^2.14.7",
    "fuse.js": "^7.5.0",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.14",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@iconify-json/carbon": "^1.2.28",
    "@types/node": "^22.20.5",
    "@unocss/preset-icons": "^66.11.0",
    "@unocss/preset-typography": "^66.11.0",
    "@unocss/preset-uno": "^66.11.0",
    "@unocss/reset": "^66.11.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^25.0.1",
    "msw": "^3.0.3",
    "prettier": "^3.9.10",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.71.2",
    "unocss": "^66.11.0",
    "vite": "^7.3.7",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.12"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
