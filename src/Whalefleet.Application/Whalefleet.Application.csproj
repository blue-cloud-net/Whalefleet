<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Whalefleet.Application
===============================================================================
    应用层。用例编排、DTO 映射、对外接口抽象、跨实体协调。
    接口放置原则（详见 docs/architecture.md）：
    - 有身份的业务实体 / 值对象 / 枚举 → Core
    - 外部资源接口（DockerClientFactory、TimeProvider、SmtpSender 等）→ Application/Abstractions
    - 第三方 SDK 适配 → Infrastructure

    依赖：仅 Core 项目（不允许引用 Infrastructure / Api）。
  -->

  <ItemGroup>
    <ProjectReference Include="..\Whalefleet.Core\Whalefleet.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 暴露 DockerClient 返回类型所需 -->
    <PackageReference Include="Docker.DotNet.Enhanced" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <!-- 后台工作器（0.10.0 编排 Stack）：BackgroundService 位于 Hosting.Abstractions。
         只引 Abstractions（不含 Hosting 本体），避免把宿主外壳带进应用层。 -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!-- YAML 解析（0.10.0 编排 Stack）：解析 Compose 文件。
         ⚠️ 只在本项目引用——Core 必须保持零 NuGet（见 docs/architecture.md 的分层约束）。 -->
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <!--
    集成测试需要直达 internal 实现（Compose 解析器 / 规划器 / 时长解析等纯函数）以逐条断言
    它们的边界行为——这些是整个 0.10.0 里风险最高的纯逻辑，不该只能通过端点间接覆盖。
    Infrastructure 侧已有同样的安排（见其 csproj）。
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Whalefleet.UnitTests" />
  </ItemGroup>

</Project>