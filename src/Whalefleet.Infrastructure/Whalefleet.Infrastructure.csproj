<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Whalefleet.Infrastructure
===============================================================================
    基础设施层。第三方 SDK 适配（Docker.DotNet.Enhanced）、数据持久化实现、
    外部服务集成等的归宿。

    依赖：
    - Core（业务实体的持久化落地）
    - Application（实现 Application/Abstractions 下定义的外部资源接口）
    - Docker.DotNet.Enhanced（Docker SDK）
  -->

  <ItemGroup>
    <ProjectReference Include="..\Whalefleet.Core\Whalefleet.Core.csproj" />
    <ProjectReference Include="..\Whalefleet.Application\Whalefleet.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Docker.DotNet.Enhanced" />
    <!-- 认证处理器（0.0.8）：TLS 客户端证书 / HTTP Basic。二者都是「认证提供器」实现，
         需显式引用才会被加载；不引用时只能用无认证连接。 -->
    <PackageReference Include="Docker.DotNet.Enhanced.BasicAuth" />
    <PackageReference Include="Docker.DotNet.Enhanced.X509" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!-- 健康检查（0.0.15）：SqliteHealthCheck 的实现与命名注册（AddCheck 需要命名） -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <!-- Registry 连通性探测（0.4.0）：只有本包提供 IHttpClientFactory -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <!-- 登录失败计数（IMemoryCache） -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>

  <!-- 持久化：Dapper（手写 SQL 的微 ORM）+ Microsoft.Data.Sqlite（ADO.NET 提供程序） -->
  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <!-- 安全：Argon2id 密码哈希 + JWT 签发（仅本层引用；Core 不引用任何 NuGet） -->
  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
  </ItemGroup>

  <!-- 集成测试需要直达 internal 实现（JwtTokenService / InMemoryLoginAttemptTracker /
       Argon2PasswordHasher 等）以断言其内部契约（常量、窗口算术）。
       UnitTests 不在此列——依赖方向规定它不得引用本层。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="Whalefleet.IntegrationTests" />
  </ItemGroup>

  <!-- 建表 / 迁移脚本以嵌入资源随程序集分发，避免运行时依赖工作目录下的 .sql 文件 -->
  <ItemGroup>
    <EmbeddedResource Include="Persistence\Schema\Migrations\*.sql" />
  </ItemGroup>

</Project>