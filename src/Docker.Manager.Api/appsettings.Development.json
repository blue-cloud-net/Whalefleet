{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Docker.DotNet": "Information"
      }
    },
    // 开发环境把日志写到运行目录下的 logs/：非容器环境不存在 /app/data，
    // 直接使用 appsettings.json 中的绝对路径会导致 File sink 打开文件失败。
    // 键路径 Serilog:WriteTo:1:Args:path 对应 appsettings.json 里 WriteTo 数组的第二个元素（File sink）。
    "WriteTo:1:Args:path": "logs/app-.log"
  },
  // 开发环境把数据库放到运行目录下的 data/，与日志同样的理由：
  // 非容器环境不存在 /app/data，用绝对路径会直接打开失败。
  "Persistence": {
    "DatabasePath": "data/docker-manager.db"
  }
}