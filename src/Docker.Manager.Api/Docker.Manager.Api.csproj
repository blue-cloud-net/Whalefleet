<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Docker.Manager.Api
===============================================================================
    DDD 接口层。ASP.NET Core 10 宿主进程，托管 Controllers / SignalR Hubs / 静态前端。

    依赖：Application + Infrastructure（不直接依赖 Domain）。

    监听：开发环境 :8080；生产环境通过 Kestrel 配置或容器编排覆盖。
  -->

  <PropertyGroup>
    <RootNamespace>Docker.Manager.Api</RootNamespace>
    <AssemblyName>Docker.Manager.Api</AssemblyName>
    <!-- 仅 Api 项目显式打包 NuGet（其他项目 IsPackable=false） -->
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Docker.Manager.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Docker.Manager.Application\Docker.Manager.Application.csproj" />
    <ProjectReference Include="..\Docker.Manager.Infrastructure\Docker.Manager.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Settings.Configuration" />
  </ItemGroup>

</Project>